          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/region"
          }
        },
        "entities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/established_entity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/established_relation"
          }
        },
        "routes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/route"
          }
        }
