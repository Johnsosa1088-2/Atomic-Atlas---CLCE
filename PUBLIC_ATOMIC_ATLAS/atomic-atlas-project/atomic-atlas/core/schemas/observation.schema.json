        "restart_status": {
          "enum": [
            "FRESH",
            "RESTORED",
            "BLOCKED_SOURCE_MISMATCH",
            "BLOCKED_TOPOLOGY_MISMATCH",
            "BLOCKED_STATE_MISMATCH",
            "RESET_AFTER_BLOCKED_RESTART"
          ]
        }
      },
      "required": [
        "schema",
        "state",
        "event_count",
        "restart_status"
