        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/established_entity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/established_relation"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          }
        }
