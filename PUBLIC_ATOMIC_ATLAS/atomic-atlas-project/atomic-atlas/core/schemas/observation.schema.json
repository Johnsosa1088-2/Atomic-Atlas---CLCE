        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "directed": {
          "type": "boolean"
        },
        "reversible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "transport_enabled": {
          "type": "boolean"
