      "type": "object",
      "properties": {
        "schema": {
          "const": "ATLAS_NEUTRAL_PROFILE/0.1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "possible": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "preferred": {
          "type": "array",
