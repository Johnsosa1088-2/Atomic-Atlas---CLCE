      "type": "object",
      "properties": {
        "schema": {
          "const": "ATLAS_STATE/0.1"
        },
        "state": {
          "$ref": "#/$defs/snapshot_state"
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
