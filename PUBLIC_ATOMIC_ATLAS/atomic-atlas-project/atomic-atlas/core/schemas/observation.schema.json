        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/established_entity"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/established_relation"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "candidate_overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_overlay"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          }
        }
